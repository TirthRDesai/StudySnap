# Supabase. For local dev run `npx supabase status -o env` in the repo root and copy:
#   SUPABASE_URL           <- API_URL
#   SUPABASE_ANON_KEY      <- ANON_KEY
#   SUPABASE_SERVICE_ROLE_KEY <- SERVICE_ROLE_KEY  (server-only; never expose to the browser)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Ollama server (`ollama serve`)
OLLAMA_HOST=http://127.0.0.1:11434
GENERATION_MODEL=qwen2.5:7b-instruct
EMBEDDING_MODEL=mxbai-embed-large
# Context window passed to the model. Higher uses more VRAM.
NUM_CTX=8192

# Browser origin(s) allowed to call this API (comma-separated)
FRONTEND_ORIGIN=http://localhost:3000
MAX_UPLOAD_MB=50
