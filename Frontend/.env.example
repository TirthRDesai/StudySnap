# From `npx supabase status -o env` in the repo root: API_URL and ANON_KEY.
# These are public (shipped to the browser). Never put the service-role key here.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Base URL of the StudySnap FastAPI backend
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
